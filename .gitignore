# Secrets — never commit your real API key
.env

# Uploaded papers and anything derived from them (can be large, and
# may not be ours to redistribute — keep them local only)
data/uploads/
data/chroma/

# Copyrighted eval fixture PDFs -- kept locally to actually run eval/run_eval.py,
# but not redistributed. See the _fixture_removed note in eval/questions.json for
# why this was deliberately stripped from git history once already.
eval/fixtures/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Streamlit
.streamlit/secrets.toml

# Local dev tooling config (hardcodes a machine-specific .venv path)
.claude/

# OS / editor cruft
.DS_Store
.vscode/
